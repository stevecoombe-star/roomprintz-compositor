NEXT_PUBLIC_SUPABASE_URL=<your supabase url>
SUPABASE_SERVICE_KEY=__REPLACE_ME__
GEMINI_API_KEY=__REPLACE_ME__
VIBODE_DUMP_ANNOTATED_IMAGE=0
VIBODE_STRICT=0
VIBODE_DEBUG_DIR=tmp/vibode_debug

# AFC-SR1 research routes are disabled unless explicitly enabled here or in
# compositor .env.local. Accepted truthy values: 1, true, yes, on.
AFC_SR1_TR2_READER_ENABLED=0
AFC_SR1_TS0_CHILD_PLACEMENT_ENABLED=0

# Optional certified research listen address (defaults shown).
AFC_SR1_RESEARCH_HOST=127.0.0.1
AFC_SR1_RESEARCH_PORT=8000
